   "July 2025",
   "Ramaphosa announces a judicial commission chaired by Justice Madlanga"
  ],
  [
   "September 2025",
   "Public hearings begin"
  ],
  [
   "September 2026",
   "The commission marks one year of testimony"
  ]
 ],
 "versus": [
  [
   "Madlanga Commission",
   "A judicial inquiry appointed by the President. It hears evidence under oath, can subpoena witnesses, and reports findings and recommendations to the President."
  ],
  [
   "Parliament’s ad hoc committee",
   "A committee of MPs investigating Mkhwanazi’s allegations separately. Some of the same people appear, but it reports to Parliament, not the President."
  ]
 ],
 "glossary": [
  [
   "Evidence leader",
   "A lawyer who questions witnesses for the commission. They do not take sides."
  ],
  [
   "In camera",
   "Evidence heard in private, without the public or media."
  ],
  [
   "IDAC",
   "Investigating Directorate Against Corruption, a unit of the National Prosecuting Authority."
  ],
  [
   "Crime Intelligence",
   "The police division that gathers intelligence on crime."
  ],
  [
   "Subpoena",
   "A legal order to appear and give evidence."
  ],
  [
   "Perjury",
   "Lying under oath, a criminal offence."
  ],
  [
   "Findings",
   "The commission’s conclusions in its final report, which come at the end, not during hearings."
  ]
 ],
